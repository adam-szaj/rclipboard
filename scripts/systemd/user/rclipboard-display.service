[Unit]
Description=rclipboard display environment publisher (user)
# Bound to the graphical session: starts only once *this* user has a graphical
# session, and is stopped/garbage-collected when that session goes away. It is
# fully independent of rclipboard.service — the main server never needs to know
# about DISPLAY, it stays transparent.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Publish the current graphical session's display variables into a small
# env-file that xsel re-reads on every invocation. We pull them from the
# systemd user manager (where GNOME/the session import them after login).
# A short wait covers the race where this unit is reached just before the
# variables are imported.
ExecStart=/bin/sh -c '\
    DIR="%t/rclipboard"; \
    FILE="$DIR/display.env"; \
    mkdir -p "$DIR"; \
    for i in $(seq 1 30); do \
        systemctl --user show-environment | grep -q "^DISPLAY=" && break; \
        sleep 1; \
    done; \
    : > "$FILE.tmp"; \
    for V in DISPLAY WAYLAND_DISPLAY XAUTHORITY; do \
        LINE=$(systemctl --user show-environment | grep "^$V=") || continue; \
        printf "%s\\n" "$LINE" >> "$FILE.tmp"; \
    done; \
    mv "$FILE.tmp" "$FILE"'
# When the graphical session stops, drop the file so xsel correctly reports
# "no DISPLAY" instead of poking a dead server.
ExecStop=/bin/sh -c 'rm -f "%t/rclipboard/display.env"'

[Install]
WantedBy=graphical-session.target
