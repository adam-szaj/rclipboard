#!/usr/bin/env bash
# rclipctl: CLI for rclipboard transports
set -euo pipefail

if [ $# -lt 1 ]; then
    echo "usage: $0 <put|get|exec|keygen|register|keys-list|status|topics|health> [options]" >&2
    exit 1
fi

cmd="$1"; shift

RCLIP_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rclipboard"

# ── keygen (local-only, no transport needed) ─────────────────────────────────
if [ "$cmd" = "keygen" ]; then
    key_file="$RCLIP_CONFIG_DIR/age_key.txt"
    pub_file="$RCLIP_CONFIG_DIR/age_key.pub"

    if [ -f "$key_file" ]; then
        echo "Key already exists at $key_file"
        echo "Public key: $(cat "$pub_file")"
        exit 0
    fi

    if ! command -v age-keygen >/dev/null 2>&1; then
        echo "error: age-keygen not found in PATH" >&2
        echo "Install age: https://github.com/FiloSottile/age#installation" >&2
        exit 1
    fi

    mkdir -p "$RCLIP_CONFIG_DIR"
    age-keygen -o "$key_file" 2>/dev/null
    chmod 600 "$key_file"
    grep '^# public key:' "$key_file" | awk '{print $NF}' > "$pub_file"
    echo "Generated key: $key_file"
    echo "Public key: $(cat "$pub_file")"
    exit 0
fi

# ── exec (local-only, no transport needed) ───────────────────────────────────
if [ "$cmd" = "exec" ]; then
    exec_encrypt_output=0
    exec_decrypt_input=0
    exec_rclip_args=()
    exec_wrapped=()
    past_sep=0

    for _a in "$@"; do
        if   [ "$past_sep" = 1 ];              then exec_wrapped+=("$_a")
        elif [ "$_a" = "--" ];                  then past_sep=1
        elif [ "$_a" = "--encrypt-output" ];    then exec_encrypt_output=1
        elif [ "$_a" = "--decrypt-input" ];     then exec_decrypt_input=1
        else                                        exec_rclip_args+=("$_a")
        fi
    done
    unset _a

    [ ${#exec_wrapped[@]} -eq 0 ] && { echo "error: exec requires -- <command>" >&2; exit 1; }
    if [ "$exec_encrypt_output" = 0 ] && [ "$exec_decrypt_input" = 0 ]; then
        echo "error: exec requires --encrypt-output or --decrypt-input" >&2; exit 1
    fi
    if [ "$exec_encrypt_output" = 1 ] && [ "$exec_decrypt_input" = 1 ]; then
        echo "error: --encrypt-output and --decrypt-input are mutually exclusive" >&2; exit 1
    fi

    # These are needed by build_age_recipients / require_age / encrypt_value
    EXTRA_KEYS=()
    KNOWN_KEYS_FILE="${RCLIPBOARD_KNOWN_KEYS_FILE:-$RCLIP_CONFIG_DIR/known_keys}"
    AGE_KEY_FILE="${RCLIPBOARD_AGE_KEY_FILE:-$RCLIP_CONFIG_DIR/age_key.txt}"
    fetch_keys=0

    if [ "$exec_encrypt_output" = 1 ]; then
        # Parse encryption options from args before --
        set -- "${exec_rclip_args[@]+"${exec_rclip_args[@]}"}"
        _exec_args=$(getopt -o "" -l "key:,key-file:,fetch-keys,config:" -- "$@") || exit 2
        eval set -- "$_exec_args"
        while true; do
            case "$1" in
                --key)        EXTRA_KEYS+=("$2"); shift 2 ;;
                --key-file)   KNOWN_KEYS_FILE="$2"; shift 2 ;;
                --fetch-keys) fetch_keys=1; shift ;;
                --config)     shift 2 ;;
                --)           shift; break ;;
                *)            break ;;
            esac
        done

        require_age() {
            command -v age >/dev/null 2>&1 && return
            echo "error: age not found in PATH" >&2
            echo "Install age: https://github.com/FiloSottile/age#installation" >&2
            exit 1
        }
        build_age_recipients() {
            local recipients=()
            for k in "${EXTRA_KEYS[@]}"; do
                recipients+=(-r "$k")
            done
            if [ -r "$KNOWN_KEYS_FILE" ]; then
                while IFS= read -r line; do
                    line="${line%%#*}"; line="${line// /}"
                    [ -n "$line" ] && recipients+=(-r "$line")
                done < "$KNOWN_KEYS_FILE"
            fi
            if [ "$fetch_keys" = "1" ] && [ -n "${BASE:-}" ]; then
                local server_keys
                server_keys=$(curl "${CURL_SOCK_OPTS[@]:-}" -fsS "${BASE}/v1/keys.list" 2>/dev/null \
                    | jq -r '.keys[].public_key' 2>/dev/null) || true
                while IFS= read -r k; do
                    [ -n "$k" ] && recipients+=(-r "$k")
                done <<< "$server_keys"
            fi
            if [ ${#recipients[@]} -eq 0 ]; then
                echo "error: --encrypt-output requires recipients via --key, $KNOWN_KEYS_FILE, or --fetch-keys" >&2
                exit 1
            fi
            printf '%s\n' "${recipients[@]}"
        }

        require_age
        raw_output=$("${exec_wrapped[@]}") || { ec=$?; exit $ec; }
        [ -z "$raw_output" ] && exit 0
        mapfile -t _recipients < <(build_age_recipients)
        printf '%s' "$raw_output" | age "${_recipients[@]}" | base64 -w 0
        exit $?
    fi

    if [ "$exec_decrypt_input" = 1 ]; then
        require_age() {
            command -v age >/dev/null 2>&1 && return
            echo "error: age not found in PATH" >&2
            echo "Install age: https://github.com/FiloSottile/age#installation" >&2
            exit 1
        }
        require_age
        if [ ! -r "$AGE_KEY_FILE" ]; then
            echo "error: no key at $AGE_KEY_FILE — run: rclipctl keygen" >&2; exit 1
        fi
        base64 -d | age --decrypt -i "$AGE_KEY_FILE" | "${exec_wrapped[@]}"
        exit $?
    fi
fi

# ── locate rclipboard binary ─────────────────────────────────────────────────
find_rclipboard() {
    if command -v rclipboard >/dev/null 2>&1; then
        echo "rclipboard"; return
    fi
    local venv_bin="$RCLIP_CONFIG_DIR/venv/bin/rclipboard"
    if [ -x "$venv_bin" ]; then
        echo "$venv_bin"; return
    fi
    return 1
}

# ── pre-scan for --config before loading env ─────────────────────────────────
CONFIG_FILE=""
_prev=""
for _arg in "$@"; do
    case "$_arg" in
        --config=*) CONFIG_FILE="${_arg#--config=}" ;;
        *)          [ "$_prev" = "--config" ] && CONFIG_FILE="$_arg" ;;
    esac
    _prev="$_arg"
done
unset _prev _arg

# ── option defaults ───────────────────────────────────────────────────────────
encoded=0
json=0
topic=c
encoding=""
mode="$cmd"
encrypt=0
fetch_keys=0
EXTRA_KEYS=()
KNOWN_KEYS_FILE="${RCLIPBOARD_KNOWN_KEYS_FILE:-$RCLIP_CONFIG_DIR/known_keys}"
AGE_KEY_FILE="${RCLIPBOARD_AGE_KEY_FILE:-$RCLIP_CONFIG_DIR/age_key.txt}"
REGISTER_TOKEN="${RCLIPBOARD_ADMIN_TOKEN:-}"
REGISTER_LABEL=""

HOST=127.0.0.1
PORT=8989
UDS=
FIFO=
ENDPOINT=
TRANSPORT_SELECT=auto
CLI_CONFIGURED=0

usage() {
    cat << EOS
Subcommands:
  put [options]            read stdin and call clip.put
  get [options]            call clip.get
  clip [options]           alias for put
  exec --encrypt-output [enc-opts] -- <cmd>  run cmd, encrypt stdout, print to stdout
  exec --decrypt-input -- <cmd>              decrypt stdin, pipe plaintext to cmd stdin
  keygen                   generate age keypair for encryption
  register                 register public key with server (requires --token)
  keys-list                list registered public keys
  status [options]         server status
  topics [options]         list topics
  health [options]         server health

Exec options:
  --encrypt-output         encrypt captured stdout of cmd, print to stdout
  --decrypt-input          decrypt stdin, feed plaintext to cmd stdin
  --key <age1pubkey>       recipient key (repeatable, for --encrypt-output)
  --key-file <path>        file with recipient keys (for --encrypt-output)
  --fetch-keys             fetch keys from server (for --encrypt-output)

Connection options:
  --config <file>                     path to config.toml
  --endpoint <url>                    host:port | http://... | uds:///path | fifo:///dir
  --transport <auto|fifo|uds|tcp>
  --host <host>  --port <port>
  --uds <socket>
  --fifo <dir>

Clip options:
  -t|--topic <topic>                              default: c
  -c|--clipboard | -p|--primary | -s|--secondary  shortcuts for -t c/p/s
  --json                                          print raw JSON result
  -a|--app <app>                                  meta.app tag
  --encoding base64|hex                           binary encoding
  -e|--encoded                                    stdin is already encoded (put)
  -E|--encrypt                                    encrypt payload with age
  --key <age1pubkey>                              recipient public key (repeatable)
  --key-file <path>                               file with recipient public keys
  --fetch-keys                                    fetch registered keys from server

Register options:
  --token <token>      admin token (or RCLIPBOARD_ADMIN_TOKEN env var)
  --label <label>      key label (default: hostname)
  -h|--help
EOS
}

# ── load configuration ────────────────────────────────────────────────────────
_RUNTIME_ENV="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/rclipboard/env"
if [ -z "${RCLIP_CONF:-}" ]; then
    if [ -r "$_RUNTIME_ENV" ]; then
        RCLIP_CONF="$_RUNTIME_ENV"
    else
        RCLIP_CONF="$HOME/.config/rclipboard/env"
    fi
fi
unset _RUNTIME_ENV

if [ -n "$CONFIG_FILE" ]; then
    RCLIPBOARD_BIN="$(find_rclipboard)" || {
        echo "error: rclipboard not found in PATH; cannot load --config" >&2
        exit 1
    }
    # shellcheck disable=SC2046
    eval "$("$RCLIPBOARD_BIN" config env --config "$CONFIG_FILE")"
elif [ -r "$RCLIP_CONF" ]; then
    # shellcheck disable=SC1090
    . "$RCLIP_CONF"
elif [ -f "$HOME/.config/rclipboard/config.toml" ]; then
    if RCLIPBOARD_BIN="$(find_rclipboard 2>/dev/null)"; then
        # shellcheck disable=SC2046
        eval "$("$RCLIPBOARD_BIN" config env --config "$HOME/.config/rclipboard/config.toml")"
    fi
fi

# Apply loaded env vars to local variables
if [ -n "${RCLIPBOARD_ENDPOINT:-}" ];  then ENDPOINT="$RCLIPBOARD_ENDPOINT"; fi
if [ -n "${RCLIPBOARD_FIFO_DIR:-}" ];  then FIFO="$RCLIPBOARD_FIFO_DIR"; fi
if [ -z "$ENDPOINT" ] && [ -n "${RCLIPBOARD_BIND_UDS:-}" ]; then
    UDS="$RCLIPBOARD_BIND_UDS"
fi
if [ -n "${RCLIPBOARD_BIND_ADDR:-}" ]; then HOST="$RCLIPBOARD_BIND_ADDR"; fi
if [ -n "${RCLIPBOARD_BIND_PORT:-}" ]; then PORT="$RCLIPBOARD_BIND_PORT"; fi
if [ -n "${RCLIPCTL_TRANSPORT:-}" ];   then TRANSPORT_SELECT="$RCLIPCTL_TRANSPORT"; fi
if [ -n "${RCLIPCTL_ENDPOINT:-}" ];    then ENDPOINT="$RCLIPCTL_ENDPOINT"; fi
if [ -n "${RCLIPCTL_FIFO_DIR:-}" ];    then FIFO="$RCLIPCTL_FIFO_DIR"; fi
if [ -n "${RCLIPCTL_UDS:-}" ];         then UDS="$RCLIPCTL_UDS"; fi
if [ -n "${RCLIPCTL_HOST:-}" ];        then HOST="$RCLIPCTL_HOST"; fi
if [ -n "${RCLIPCTL_PORT:-}" ];        then PORT="$RCLIPCTL_PORT"; fi
if [ -n "${RCLIPCTL_HOST:-}" ] || [ -n "${RCLIPCTL_PORT:-}" ]; then
    ENDPOINT=""
fi

# ── parse subcommand options ──────────────────────────────────────────────────
args=$(getopt -o "cpsEet:h" \
    -l "app:,clipboard,primary,secondary,encoded,encrypt,fetch-keys,json,help,encoding:,\
endpoint:,fifo:,host:,port:,transport:,uds:,topic:,config:,key:,key-file:,token:,label:" \
    -- "$@")
eval set -- "$args"

while true; do
    case "$1" in
        -t|--topic)     topic="$2";             shift 2 ;;
        -c|--clipboard) topic="c";              shift ;;
        -p|--primary)   topic="p";              shift ;;
        -s|--secondary) topic="s";              shift ;;
        -e|--encoded)   encoded=1;              shift ;;
        -E|--encrypt)   encrypt=1;              shift ;;
        --fetch-keys)   fetch_keys=1;           shift ;;
        --key)          EXTRA_KEYS+=("$2");     shift 2 ;;
        --key-file)     KNOWN_KEYS_FILE="$2";   shift 2 ;;
        --token)        REGISTER_TOKEN="$2";    shift 2 ;;
        --label)        REGISTER_LABEL="$2";    shift 2 ;;
        --json)         json=1;                 shift ;;
        --encoding)     encoding=$2;            shift 2 ;;
        --endpoint)     ENDPOINT=$2; CLI_CONFIGURED=1; shift 2 ;;
        --fifo)         FIFO=$2;    CLI_CONFIGURED=1; shift 2 ;;
        --transport)    TRANSPORT_SELECT=$2;    shift 2 ;;
        -a|--app)       app=$2;                 shift 2 ;;
        --host)         HOST=$2;    CLI_CONFIGURED=1; shift 2 ;;
        --port)         PORT=$2;    CLI_CONFIGURED=1; shift 2 ;;
        --uds)          UDS=$2;     CLI_CONFIGURED=1; shift 2 ;;
        --config)       shift 2 ;;   # already consumed above
        -h|--help)      usage; exit 0 ;;
        --)             shift; break ;;
        *)              break ;;
    esac
done

# ── transport resolution ──────────────────────────────────────────────────────
CLI_FIFO=
CLI_UDS=
CLI_TCP=
ENV_FIFO=
ENV_UDS=
ENV_TCP=

parse_endpoint_to_candidate() {
    local target="$1"
    local raw="$2"
    if [ -z "$raw" ]; then return; fi

    case "$raw" in
        http://*|https://*)
            printf -v "${target}" '%s' "$raw" ;;
        uds://*)
            printf -v "${target}" '%s' "${raw#uds://}" ;;
        fifo://*)
            printf -v "${target}" '%s' "${raw#fifo://}" ;;
        /*)
            printf -v "${target}" '%s' "$raw" ;;
        *:*)
            printf -v "${target}" '%s' "http://${raw}" ;;
        *)
            echo "unsupported endpoint: $raw" >&2
            exit 2 ;;
    esac
}

resolve_candidates() {
    if [ "$CLI_CONFIGURED" = "1" ]; then
        if [ -n "$ENDPOINT" ]; then
            case "$ENDPOINT" in
                fifo://*)
                    parse_endpoint_to_candidate CLI_FIFO "$ENDPOINT" ;;
                uds://*|/*)
                    if [ "${ENDPOINT#uds://}" != "$ENDPOINT" ] || [ ! -d "$ENDPOINT" ]; then
                        parse_endpoint_to_candidate CLI_UDS "$ENDPOINT"
                    else
                        parse_endpoint_to_candidate CLI_FIFO "$ENDPOINT"
                    fi ;;
                http://*|https://*|*:*)
                    parse_endpoint_to_candidate CLI_TCP "$ENDPOINT" ;;
            esac
        fi
        if [ -n "$FIFO" ]; then CLI_FIFO="$FIFO"; fi
        if [ -n "$UDS" ];  then CLI_UDS="$UDS"; fi
        if [ -n "$HOST" ] || [ -n "$PORT" ]; then CLI_TCP="http://${HOST}:${PORT}"; fi
        return
    fi

    if [ -n "$ENDPOINT" ]; then
        case "$ENDPOINT" in
            fifo://*)
                parse_endpoint_to_candidate ENV_FIFO "$ENDPOINT" ;;
            uds://*|/*)
                if [ "${ENDPOINT#uds://}" != "$ENDPOINT" ] || [ ! -d "$ENDPOINT" ]; then
                    parse_endpoint_to_candidate ENV_UDS "$ENDPOINT"
                else
                    parse_endpoint_to_candidate ENV_FIFO "$ENDPOINT"
                fi ;;
            http://*|https://*|*:*)
                parse_endpoint_to_candidate ENV_TCP "$ENDPOINT" ;;
        esac
    fi
    if [ -n "$UDS" ];  then ENV_UDS="$UDS"; fi
    if [ -z "$ENV_TCP" ]; then ENV_TCP="http://${HOST}:${PORT}"; fi
    if [ -n "$FIFO" ]; then ENV_FIFO="$FIFO"; fi
}

select_transport() {
    local fifo_candidate uds_candidate tcp_candidate
    if [ "$CLI_CONFIGURED" = "1" ]; then
        fifo_candidate="$CLI_FIFO"
        uds_candidate="$CLI_UDS"
        tcp_candidate="$CLI_TCP"
    else
        fifo_candidate="$ENV_FIFO"
        uds_candidate="$ENV_UDS"
        tcp_candidate="$ENV_TCP"
    fi

    case "$TRANSPORT_SELECT" in
        auto)
            if [ -n "$uds_candidate" ]; then
                TRANSPORT=uds;  UDS_PATH="$uds_candidate"
            elif [ -n "$tcp_candidate" ]; then
                TRANSPORT=tcp;  BASE="$tcp_candidate"
            elif [ -n "$fifo_candidate" ]; then
                TRANSPORT=fifo; FIFO_DIR="$fifo_candidate"
            else
                echo "no usable transport configured" >&2; exit 2
            fi ;;
        fifo)
            [ -z "$fifo_candidate" ] && { echo "fifo transport requested but not configured" >&2; exit 2; }
            TRANSPORT=fifo; FIFO_DIR="$fifo_candidate" ;;
        uds)
            [ -z "$uds_candidate" ] && { echo "uds transport requested but not configured" >&2; exit 2; }
            TRANSPORT=uds; UDS_PATH="$uds_candidate" ;;
        tcp)
            [ -z "$tcp_candidate" ] && { echo "tcp transport requested but not configured" >&2; exit 2; }
            TRANSPORT=tcp; BASE="$tcp_candidate" ;;
        *)
            echo "unsupported transport: $TRANSPORT_SELECT" >&2; exit 2 ;;
    esac
}

resolve_candidates
select_transport

if [ "${TRANSPORT:-}" = "uds" ]; then
    BASE="http://localhost"
    CURL_SOCK_OPTS=(--unix-socket "$UDS_PATH")
else
    CURL_SOCK_OPTS=()
fi

if [ -z "${app:-}" ]; then app=rclipctl; fi

# ── HTTP helpers ──────────────────────────────────────────────────────────────
endpoint_url() { echo "${BASE}${1}"; }

fifo_path() {
    local kind="$1"
    case "$kind" in
        put_raw)   echo "${FIFO_DIR}/put.${topic}.fifo" ;;
        put_json)  echo "${FIFO_DIR}/put.${topic}.fifo.json" ;;
        state_raw) echo "${FIFO_DIR}/state.${topic}" ;;
        state_json)echo "${FIFO_DIR}/state.${topic}.json" ;;
        topics)    echo "${FIFO_DIR}/topics.json" ;;
        status)    echo "${FIFO_DIR}/status.json" ;;
        health)    echo "${FIFO_DIR}/health.json" ;;
    esac
}

ensure_fifo_dir() {
    if [ ! -d "$FIFO_DIR" ]; then
        echo "fifo endpoint directory does not exist: $FIFO_DIR" >&2; exit 2
    fi
}

# ── encryption helpers ────────────────────────────────────────────────────────
require_age() {
    command -v age >/dev/null 2>&1 && return
    echo "error: age not found in PATH" >&2
    echo "Install age: https://github.com/FiloSottile/age#installation" >&2
    exit 1
}

build_age_recipients() {
    local recipients=()
    for k in "${EXTRA_KEYS[@]}"; do
        recipients+=(-r "$k")
    done
    if [ -r "$KNOWN_KEYS_FILE" ]; then
        while IFS= read -r line; do
            line="${line%%#*}"
            line="${line// /}"
            [ -n "$line" ] && recipients+=(-r "$line")
        done < "$KNOWN_KEYS_FILE"
    fi
    if [ "$fetch_keys" = "1" ]; then
        local server_keys
        server_keys=$(curl "${CURL_SOCK_OPTS[@]}" -fsS "${BASE}/v1/keys.list" 2>/dev/null \
            | jq -r '.keys[].public_key' 2>/dev/null) || true
        while IFS= read -r k; do
            [ -n "$k" ] && recipients+=(-r "$k")
        done <<< "$server_keys"
    fi
    if [ ${#recipients[@]} -eq 0 ]; then
        echo "error: --encrypt requires recipients via --key, $KNOWN_KEYS_FILE, or --fetch-keys" >&2
        exit 1
    fi
    printf '%s\n' "${recipients[@]}"
}

encrypt_value() {
    local raw_b64="$1"
    local recipients
    recipients=($(build_age_recipients))
    require_age
    printf '%s' "$raw_b64" | base64 -d | age "${recipients[@]}" | base64 -w 0
}

# ── clip put ──────────────────────────────────────────────────────────────────
call_put() {
    if [ "${TRANSPORT:-}" = "fifo" ]; then call_put_fifo; return; fi
    local url; url=$(endpoint_url "/v1/clip.put")

    local input_enc="${encoding}"
    local api_enc="base64"
    if [ -z "${input_enc}" ]; then input_enc="base64"; fi

    local value
    if [ "$encoded" = "1" ]; then
        case "$input_enc" in
            base64) value=$(cat) ;;
            hex)    value=$(xxd -r -p | base64 -w 0 -) ;;
            *)      echo "unsupported encoded input for put: ${input_enc}" >&2; exit 2 ;;
        esac
    else
        value=$(base64 -w 0 -)
    fi

    local is_encrypted=false
    if [ "$encrypt" = "1" ]; then
        value=$(encrypt_value "$value")
        is_encrypted=true
    fi

    local body
    body=$(jq -nc \
        --arg topic "$topic" \
        --arg value "$value" \
        --arg mime "application/octet-stream" \
        --arg enc "$api_enc" \
        --argjson encrypted "$is_encrypted" \
        --arg app "$app" \
        '{items:[{topic:$topic,value:$value,mime:$mime,encoding:$enc,encrypted:$encrypted}],meta:{app:$app}}')

    curl "${CURL_SOCK_OPTS[@]}" -fsS \
        -X POST "$url" -H 'Content-Type: application/json' -d "$body" \
    | { if [ "$json" = "1" ]; then jq -c; else cat >/dev/null; fi; }
}

# ── clip get ──────────────────────────────────────────────────────────────────
encode() {
    case "$1" in
        "null")   cat ;;
        "base64") base64 -w 0 ;;
        "hex")    xxd -p -c 9999 ;;
    esac
}

decode() {
    case "$1" in
        "null")   cat ;;
        "base64") base64 -d - ;;
        "hex")    xxd -r -p ;;
    esac
}

resolve_output_encoding() {
    if [ -n "${encoding}" ]; then encoded=1; fi
    if [ "${encoded}" = 1 ]; then
        if [ -z "${encoding}" ]; then encoding=base64; fi
    else
        encoding=null
    fi
}

call_get() {
    if [ "${TRANSPORT:-}" = "fifo" ]; then call_get_fifo; return; fi
    local url; url=$(endpoint_url "/v1/clip.get")
    body=$(jq -cn --arg topic "$topic" '{topic: $topic}')

    local extra_get_headers=()
    if [ -r "$RCLIP_CONFIG_DIR/age_key.pub" ]; then
        local own_pub_key
        own_pub_key=$(cat "$RCLIP_CONFIG_DIR/age_key.pub")
        [ -n "$own_pub_key" ] && extra_get_headers+=(-H "X-Age-Public-Key: $own_pub_key")
    fi

    resp=$(printf '%s' "$body" | curl "${CURL_SOCK_OPTS[@]}" -fsS \
        "${extra_get_headers[@]}" \
        -X POST "$url" -H 'Content-Type: application/json' --data-binary @-)

    if [ "$json" = "1" ]; then printf '%s' "$resp" | jq -c; return; fi

    eval "$(printf '%s' "$resp" | jq -r '.item | "is_encrypted=\(.encrypted // false) mime=\(.mime // "empty") venc=\(.encoding // "empty")"')"
    val=$(printf '%s' "$resp" | jq -r '.item.value')

    if [ "$is_encrypted" = "true" ]; then
        require_age
        if [ ! -r "$AGE_KEY_FILE" ]; then
            echo "error: encrypted content but no key at $AGE_KEY_FILE" >&2
            echo "Run: rclipctl keygen" >&2
            exit 1
        fi
        local decrypted
        decrypted=$(printf '%s' "$val" | decode "$venc" | age --decrypt -i "$AGE_KEY_FILE" 2>/dev/null)
        if [ $? -ne 0 ]; then
            echo "error: decryption failed (no matching key?)" >&2
            exit 1
        fi
        resolve_output_encoding
        printf '%s' "$decrypted" | encode "${encoding}"
        return
    fi

    if [[ "$mime" == text/* && "$venc" == "utf-8" ]]; then printf '%s' "$val"; return; fi

    resolve_output_encoding
    printf '%s' "$val" | decode "$venc" | encode "${encoding}"
}

# ── key registry ─────────────────────────────────────────────────────────────
call_register() {
    local pub_key
    pub_key=$(cat "$RCLIP_CONFIG_DIR/age_key.pub" 2>/dev/null || true)
    if [ -z "$pub_key" ]; then
        echo "error: no public key found at $RCLIP_CONFIG_DIR/age_key.pub" >&2
        echo "Run: rclipctl keygen" >&2
        exit 1
    fi
    if [ -z "$REGISTER_TOKEN" ]; then
        echo "error: admin token required. Use --token or set RCLIPBOARD_ADMIN_TOKEN" >&2
        exit 1
    fi
    local label="${REGISTER_LABEL:-$(hostname)}"
    local body
    body=$(jq -nc --arg pk "$pub_key" --arg lbl "$label" '{"public_key":$pk,"label":$lbl}')
    curl "${CURL_SOCK_OPTS[@]}" -fsS \
        -X POST "$(endpoint_url "/v1/keys.publish")" \
        -H 'Content-Type: application/json' \
        -H "Authorization: Bearer $REGISTER_TOKEN" \
        -d "$body" | jq -c
}

call_keys_list() {
    curl "${CURL_SOCK_OPTS[@]}" -fsS "$(endpoint_url "/v1/keys.list")" | jq -c
}

# ── status / topics / health ──────────────────────────────────────────────────
call_status() {
    if [ "${TRANSPORT:-}" = "fifo" ]; then ensure_fifo_dir; jq -c . "$(fifo_path status)"; return; fi
    curl "${CURL_SOCK_OPTS[@]}" -fsS "${BASE}/v1/status.get" | jq -c
}

call_topics() {
    if [ "${TRANSPORT:-}" = "fifo" ]; then ensure_fifo_dir; jq -c . "$(fifo_path topics)"; return; fi
    curl "${CURL_SOCK_OPTS[@]}" -fsS -X POST "${BASE}/v1/topics.list" \
        -H 'Content-Type: application/json' --data-binary '{}' | jq -c
}

call_health() {
    if [ "${TRANSPORT:-}" = "fifo" ]; then ensure_fifo_dir; jq -c . "$(fifo_path health)"; return; fi
    curl "${CURL_SOCK_OPTS[@]}" -fsS "${BASE}/v1/health.get" | jq -c
}

# ── FIFO put / get ────────────────────────────────────────────────────────────
call_put_fifo() {
    local path; path=$(fifo_path put_raw)
    ensure_fifo_dir
    if [ ! -p "$path" ]; then mkfifo "$path"; fi

    local transform_cmd='cat'
    if [ "$encoded" = "1" ]; then
        if [ "${encoding:-base64}" = "base64" ]; then
            transform_cmd='base64 -d -'
        elif [ "$encoding" = "hex" ]; then
            transform_cmd='xxd -r -p'
        else
            echo "unsupported encoded input for fifo put: ${encoding}" >&2; exit 2
        fi
    fi
    bash -lc "${transform_cmd}" > "$path"
}

call_get_fifo() {
    ensure_fifo_dir
    if [ "$json" = "1" ]; then jq -c . "$(fifo_path state_json)"; return; fi

    local path; path=$(fifo_path state_raw)
    if [ ! -f "$path" ]; then echo "topic state not found: $topic" >&2; exit 1; fi

    resolve_output_encoding
    cat "$path" | encode "${encoding}"
}

# ── dispatch ──────────────────────────────────────────────────────────────────
case "$mode" in
    put|clip)   call_put ;;
    get)        call_get ;;
    register)   call_register ;;
    keys-list)  call_keys_list ;;
    status)     call_status ;;
    topics)     call_topics ;;
    health)     call_health ;;
    *)          echo "unknown subcommand: $mode" >&2; usage; exit 2 ;;
esac
