#!/usr/bin/env bash
# rclipctl: CLI for rclipboard transports
set -euo pipefail

if [ $# -lt 1 ]; then
    echo "usage: $0 <put|get|status|topics|health> [options]" >&2
    exit 1
fi

cmd="$1"; shift

# ── locate rclipboard binary ─────────────────────────────────────────────────
find_rclipboard() {
    if command -v rclipboard >/dev/null 2>&1; then
        echo "rclipboard"; return
    fi
    local venv_bin="$HOME/.config/rclipboard/venv/bin/rclipboard"
    if [ -x "$venv_bin" ]; then
        echo "$venv_bin"; return
    fi
    return 1
}

# ── pre-scan for --config before loading env ─────────────────────────────────
CONFIG_FILE=""
_prev=""
for _arg in "$@"; do
    case "$_arg" in
        --config=*) CONFIG_FILE="${_arg#--config=}" ;;
        *)          [ "$_prev" = "--config" ] && CONFIG_FILE="$_arg" ;;
    esac
    _prev="$_arg"
done
unset _prev _arg

# ── option defaults ───────────────────────────────────────────────────────────
encoded=0
json=0
topic=c
encoding=""
mode="$cmd"

HOST=127.0.0.1
PORT=8989
UDS=
FIFO=
ENDPOINT=
TRANSPORT_SELECT=auto
CLI_CONFIGURED=0

usage() {
    cat << EOS
Subcommands:
  put [options]     read stdin and call clip.put
  get [options]     call clip.get
  clip [options]    alias for put
  status [options]  server status
  topics [options]  list topics
  health [options]  server health

Connection options:
  --config <file>                     path to config.toml
  --endpoint <url>                    host:port | http://... | uds:///path | fifo:///dir
  --transport <auto|fifo|uds|tcp>
  --host <host>  --port <port>
  --uds <socket>
  --fifo <dir>

Clip options:
  -t|--topic <topic>                              default: c
  -c|--clipboard | -p|--primary | -s|--secondary  shortcuts for -t c/p/s
  --json                                          print raw JSON result
  -a|--app <app>                                  meta.app tag
  --encoding base64|hex                           binary encoding
  -e|--encoded                                    stdin is already encoded (put)
  -h|--help
EOS
}

# ── load configuration ────────────────────────────────────────────────────────
_RUNTIME_ENV="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/rclipboard/env"
if [ -z "${RCLIP_CONF:-}" ]; then
    if [ -r "$_RUNTIME_ENV" ]; then
        RCLIP_CONF="$_RUNTIME_ENV"
    else
        RCLIP_CONF="$HOME/.config/rclipboard/env"
    fi
fi
unset _RUNTIME_ENV

if [ -n "$CONFIG_FILE" ]; then
    RCLIPBOARD_BIN="$(find_rclipboard)" || {
        echo "error: rclipboard not found in PATH; cannot load --config" >&2
        exit 1
    }
    # shellcheck disable=SC2046
    eval "$("$RCLIPBOARD_BIN" config env --config "$CONFIG_FILE")"
elif [ -r "$RCLIP_CONF" ]; then
    # shellcheck disable=SC1090
    . "$RCLIP_CONF"
elif [ -f "$HOME/.config/rclipboard/config.toml" ]; then
    if RCLIPBOARD_BIN="$(find_rclipboard 2>/dev/null)"; then
        # shellcheck disable=SC2046
        eval "$("$RCLIPBOARD_BIN" config env --config "$HOME/.config/rclipboard/config.toml")"
    fi
fi

# Apply loaded env vars to local variables
if [ -n "${RCLIPBOARD_ENDPOINT:-}" ];  then ENDPOINT="$RCLIPBOARD_ENDPOINT"; fi
if [ -n "${RCLIPBOARD_FIFO_DIR:-}" ];  then FIFO="$RCLIPBOARD_FIFO_DIR"; fi
if [ -z "$ENDPOINT" ] && [ -n "${RCLIPBOARD_BIND_UDS:-}" ]; then
    UDS="$RCLIPBOARD_BIND_UDS"
fi
if [ -n "${RCLIPBOARD_BIND_ADDR:-}" ]; then HOST="$RCLIPBOARD_BIND_ADDR"; fi
if [ -n "${RCLIPBOARD_BIND_PORT:-}" ]; then PORT="$RCLIPBOARD_BIND_PORT"; fi
if [ -n "${RCLIPCTL_TRANSPORT:-}" ];   then TRANSPORT_SELECT="$RCLIPCTL_TRANSPORT"; fi
if [ -n "${RCLIPCTL_ENDPOINT:-}" ];    then ENDPOINT="$RCLIPCTL_ENDPOINT"; fi
if [ -n "${RCLIPCTL_FIFO_DIR:-}" ];    then FIFO="$RCLIPCTL_FIFO_DIR"; fi
if [ -n "${RCLIPCTL_UDS:-}" ];         then UDS="$RCLIPCTL_UDS"; fi
if [ -n "${RCLIPCTL_HOST:-}" ];        then HOST="$RCLIPCTL_HOST"; fi
if [ -n "${RCLIPCTL_PORT:-}" ];        then PORT="$RCLIPCTL_PORT"; fi
if [ -n "${RCLIPCTL_HOST:-}" ] || [ -n "${RCLIPCTL_PORT:-}" ]; then
    ENDPOINT=""
fi

# ── parse subcommand options ──────────────────────────────────────────────────
args=$(getopt -o "cpset:h" \
    -l "app:,clipboard,primary,secondary,encoded,json,help,encoding:,\
endpoint:,fifo:,host:,port:,transport:,uds:,topic:,config:" \
    -- "$@")
eval set -- "$args"

while true; do
    case "$1" in
        -t|--topic)     topic="$2";             shift 2 ;;
        -c|--clipboard) topic="c";              shift ;;
        -p|--primary)   topic="p";              shift ;;
        -s|--secondary) topic="s";              shift ;;
        -e|--encoded)   encoded=1;              shift ;;
        --json)         json=1;                 shift ;;
        --encoding)     encoding=$2;            shift 2 ;;
        --endpoint)     ENDPOINT=$2; CLI_CONFIGURED=1; shift 2 ;;
        --fifo)         FIFO=$2;    CLI_CONFIGURED=1; shift 2 ;;
        --transport)    TRANSPORT_SELECT=$2;    shift 2 ;;
        -a|--app)       app=$2;                 shift 2 ;;
        --host)         HOST=$2;    CLI_CONFIGURED=1; shift 2 ;;
        --port)         PORT=$2;    CLI_CONFIGURED=1; shift 2 ;;
        --uds)          UDS=$2;     CLI_CONFIGURED=1; shift 2 ;;
        --config)       shift 2 ;;   # already consumed above
        -h|--help)      usage; exit 0 ;;
        --)             shift; break ;;
        *)              break ;;
    esac
done

# ── transport resolution ──────────────────────────────────────────────────────
CLI_FIFO=
CLI_UDS=
CLI_TCP=
ENV_FIFO=
ENV_UDS=
ENV_TCP=

parse_endpoint_to_candidate() {
    local target="$1"
    local raw="$2"
    if [ -z "$raw" ]; then return; fi

    case "$raw" in
        http://*|https://*)
            printf -v "${target}" '%s' "$raw" ;;
        uds://*)
            printf -v "${target}" '%s' "${raw#uds://}" ;;
        fifo://*)
            printf -v "${target}" '%s' "${raw#fifo://}" ;;
        /*)
            printf -v "${target}" '%s' "$raw" ;;
        *:*)
            printf -v "${target}" '%s' "http://${raw}" ;;
        *)
            echo "unsupported endpoint: $raw" >&2
            exit 2 ;;
    esac
}

resolve_candidates() {
    if [ "$CLI_CONFIGURED" = "1" ]; then
        if [ -n "$ENDPOINT" ]; then
            case "$ENDPOINT" in
                fifo://*)
                    parse_endpoint_to_candidate CLI_FIFO "$ENDPOINT" ;;
                uds://*|/*)
                    if [ "${ENDPOINT#uds://}" != "$ENDPOINT" ] || [ ! -d "$ENDPOINT" ]; then
                        parse_endpoint_to_candidate CLI_UDS "$ENDPOINT"
                    else
                        parse_endpoint_to_candidate CLI_FIFO "$ENDPOINT"
                    fi ;;
                http://*|https://*|*:*)
                    parse_endpoint_to_candidate CLI_TCP "$ENDPOINT" ;;
            esac
        fi
        if [ -n "$FIFO" ]; then CLI_FIFO="$FIFO"; fi
        if [ -n "$UDS" ];  then CLI_UDS="$UDS"; fi
        if [ -n "$HOST" ] || [ -n "$PORT" ]; then CLI_TCP="http://${HOST}:${PORT}"; fi
        return
    fi

    if [ -n "$ENDPOINT" ]; then
        case "$ENDPOINT" in
            fifo://*)
                parse_endpoint_to_candidate ENV_FIFO "$ENDPOINT" ;;
            uds://*|/*)
                if [ "${ENDPOINT#uds://}" != "$ENDPOINT" ] || [ ! -d "$ENDPOINT" ]; then
                    parse_endpoint_to_candidate ENV_UDS "$ENDPOINT"
                else
                    parse_endpoint_to_candidate ENV_FIFO "$ENDPOINT"
                fi ;;
            http://*|https://*|*:*)
                parse_endpoint_to_candidate ENV_TCP "$ENDPOINT" ;;
        esac
    fi
    if [ -n "$FIFO" ]; then ENV_FIFO="$FIFO"; fi
    if [ -n "$UDS" ];  then ENV_UDS="$UDS"; fi
    if [ -z "$ENV_TCP" ]; then ENV_TCP="http://${HOST}:${PORT}"; fi
}

select_transport() {
    local fifo_candidate uds_candidate tcp_candidate
    if [ "$CLI_CONFIGURED" = "1" ]; then
        fifo_candidate="$CLI_FIFO"
        uds_candidate="$CLI_UDS"
        tcp_candidate="$CLI_TCP"
    else
        fifo_candidate="$ENV_FIFO"
        uds_candidate="$ENV_UDS"
        tcp_candidate="$ENV_TCP"
    fi

    case "$TRANSPORT_SELECT" in
        auto)
            if [ -n "$fifo_candidate" ]; then
                TRANSPORT=fifo; FIFO_DIR="$fifo_candidate"
            elif [ -n "$uds_candidate" ]; then
                TRANSPORT=uds;  UDS_PATH="$uds_candidate"
            elif [ -n "$tcp_candidate" ]; then
                TRANSPORT=tcp;  BASE="$tcp_candidate"
            else
                echo "no usable transport configured" >&2; exit 2
            fi ;;
        fifo)
            [ -z "$fifo_candidate" ] && { echo "fifo transport requested but not configured" >&2; exit 2; }
            TRANSPORT=fifo; FIFO_DIR="$fifo_candidate" ;;
        uds)
            [ -z "$uds_candidate" ] && { echo "uds transport requested but not configured" >&2; exit 2; }
            TRANSPORT=uds; UDS_PATH="$uds_candidate" ;;
        tcp)
            [ -z "$tcp_candidate" ] && { echo "tcp transport requested but not configured" >&2; exit 2; }
            TRANSPORT=tcp; BASE="$tcp_candidate" ;;
        *)
            echo "unsupported transport: $TRANSPORT_SELECT" >&2; exit 2 ;;
    esac
}

resolve_candidates
select_transport

if [ "${TRANSPORT:-}" = "uds" ]; then
    BASE="http://localhost"
    CURL_SOCK_OPTS=(--unix-socket "$UDS_PATH")
else
    CURL_SOCK_OPTS=()
fi

if [ -z "${app:-}" ]; then app=rclipctl; fi

# ── HTTP helpers ──────────────────────────────────────────────────────────────
endpoint_url() { echo "${BASE}${1}"; }

fifo_path() {
    local kind="$1"
    case "$kind" in
        put_raw)   echo "${FIFO_DIR}/put.${topic}.fifo" ;;
        put_json)  echo "${FIFO_DIR}/put.${topic}.fifo.json" ;;
        state_raw) echo "${FIFO_DIR}/state.${topic}" ;;
        state_json)echo "${FIFO_DIR}/state.${topic}.json" ;;
        topics)    echo "${FIFO_DIR}/topics.json" ;;
        status)    echo "${FIFO_DIR}/status.json" ;;
        health)    echo "${FIFO_DIR}/health.json" ;;
    esac
}

ensure_fifo_dir() {
    if [ ! -d "$FIFO_DIR" ]; then
        echo "fifo endpoint directory does not exist: $FIFO_DIR" >&2; exit 2
    fi
}

# ── clip put ──────────────────────────────────────────────────────────────────
make_publish_body() {
    local input_enc="${encoding}"
    local api_enc="base64"
    if [ -z "${input_enc}" ]; then input_enc="base64"; fi
    local transform_cmd='base64 -w 0 -'

    if [ "$encoded" = "1" ]; then
        if [ "$input_enc" = "base64" ]; then
            transform_cmd='cat'
        elif [ "$input_enc" = "hex" ]; then
            transform_cmd='xxd -r -p | base64 -w 0 -'
        else
            echo "unsupported encoded input for put: ${input_enc}" >&2; exit 2
        fi
    else
        transform_cmd='base64 -w 0 -'
    fi

    value=$(bash -lc "${transform_cmd}")
    cat << EOF
{
  "items": [{"topic":"${topic}","mime":"application/octet-stream","encoding":"${api_enc}","value":"${value}"}],
  "meta": {"app":"${app}"}
}
EOF
}

call_put() {
    if [ "${TRANSPORT:-}" = "fifo" ]; then call_put_fifo; return; fi
    local url; url=$(endpoint_url "/v1/clip.put")
    body=$(make_publish_body)
    echo "$body" | jq -c | curl "${CURL_SOCK_OPTS[@]}" -fsS \
        -X POST "$url" -H 'Content-Type: application/json' --data-binary @- \
        | { if [ "$json" = "1" ]; then jq -c; else cat >/dev/null; fi; }
}

# ── clip get ──────────────────────────────────────────────────────────────────
encode() {
    case "$1" in
        "null")   cat ;;
        "base64") base64 -w 0 ;;
        "hex")    xxd -p -c 9999 ;;
    esac
}

decode() {
    case "$1" in
        "null")   cat ;;
        "base64") base64 -d - ;;
        "hex")    xxd -r -p ;;
    esac
}

call_get() {
    if [ "${TRANSPORT:-}" = "fifo" ]; then call_get_fifo; return; fi
    local url; url=$(endpoint_url "/v1/clip.get")
    body=$(jq -cn --arg topic "$topic" '{topic: $topic}')
    resp=$(printf '%s' "$body" | curl "${CURL_SOCK_OPTS[@]}" -fsS \
        -X POST "$url" -H 'Content-Type: application/json' --data-binary @-)

    if [ "$json" = "1" ]; then printf '%s' "$resp" | jq -c; return; fi

    mime=$(printf '%s' "$resp" | jq -r '.item.mime // empty')
    venc=$(printf '%s' "$resp" | jq -r '.item.encoding // empty')
    val=$(printf '%s' "$resp" | jq -r '.item.value')

    if [[ "$mime" == text/* && "$venc" == "utf-8" ]]; then printf '%s' "$val"; return; fi

    if [ -n "${encoding}" ]; then encoded=1; fi
    if [ "${encoded}" = 1 ]; then
        if [ -z "${encoding}" ]; then encoding=base64; fi
    else
        encoding=null
    fi
    printf '%s' "$val" | decode "$venc" | encode "${encoding}"
}

# ── status / topics / health ──────────────────────────────────────────────────
call_status() {
    if [ "${TRANSPORT:-}" = "fifo" ]; then ensure_fifo_dir; jq -c . "$(fifo_path status)"; return; fi
    curl "${CURL_SOCK_OPTS[@]}" -fsS "${BASE}/v1/status.get" | jq -c
}

call_topics() {
    if [ "${TRANSPORT:-}" = "fifo" ]; then ensure_fifo_dir; jq -c . "$(fifo_path topics)"; return; fi
    curl "${CURL_SOCK_OPTS[@]}" -fsS -X POST "${BASE}/v1/topics.list" \
        -H 'Content-Type: application/json' --data-binary '{}' | jq -c
}

call_health() {
    if [ "${TRANSPORT:-}" = "fifo" ]; then ensure_fifo_dir; jq -c . "$(fifo_path health)"; return; fi
    curl "${CURL_SOCK_OPTS[@]}" -fsS "${BASE}/v1/health.get" | jq -c
}

# ── FIFO put / get ────────────────────────────────────────────────────────────
call_put_fifo() {
    local path; path=$(fifo_path put_raw)
    ensure_fifo_dir
    if [ ! -p "$path" ]; then mkfifo "$path"; fi

    local transform_cmd='cat'
    if [ "$encoded" = "1" ]; then
        if [ "${encoding:-base64}" = "base64" ]; then
            transform_cmd='base64 -d -'
        elif [ "$encoding" = "hex" ]; then
            transform_cmd='xxd -r -p'
        else
            echo "unsupported encoded input for fifo put: ${encoding}" >&2; exit 2
        fi
    fi
    bash -lc "${transform_cmd}" > "$path"
}

call_get_fifo() {
    ensure_fifo_dir
    if [ "$json" = "1" ]; then jq -c . "$(fifo_path state_json)"; return; fi

    local path; path=$(fifo_path state_raw)
    if [ ! -f "$path" ]; then echo "topic state not found: $topic" >&2; exit 1; fi

    if [ -n "${encoding}" ]; then encoded=1; fi
    if [ "${encoded}" = 1 ]; then
        if [ -z "${encoding}" ]; then encoding=base64; fi
    else
        encoding=null
    fi
    cat "$path" | encode "${encoding}"
}

# ── dispatch ──────────────────────────────────────────────────────────────────
case "$mode" in
    put|clip) call_put ;;
    get)      call_get ;;
    status)   call_status ;;
    topics)   call_topics ;;
    health)   call_health ;;
    *)        echo "unknown subcommand: $mode" >&2; usage; exit 2 ;;
esac
