[Unit]
Description=rclipboard service (user)
After=default.target

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'mkdir -p %t/rclipboard && %h/.config/rclipboard/venv/bin/rclipboard config env --config %h/.config/rclipboard/config.toml > %t/rclipboard/env'
EnvironmentFile=-%t/rclipboard/env
WorkingDirectory=%h/.config/rclipboard
ExecStart=%h/.config/rclipboard/venv/bin/rclipboard
Restart=on-failure
RestartSec=1s
# Backstop: with RCLIPBOARD_GRACEFUL_TIMEOUT_S the process exits in ~8s, so this
# never fires in normal operation. It caps worst-case SIGKILL escalation at 20s
# (instead of the 90s default) if a future regression re-hangs shutdown.
TimeoutStopSec=20s

[Install]
WantedBy=default.target
