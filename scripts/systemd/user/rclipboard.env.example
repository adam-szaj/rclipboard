# rclipboard environment (user)
# Copy to: ~/.config/rclipboard/env

# Bind
RCLIPBOARD_ENDPOINT=127.0.0.1:8989
# Examples:
# RCLIPBOARD_ENDPOINT=http://127.0.0.1:8989
# RCLIPBOARD_ENDPOINT=uds:///run/user/1000/rclipboard.sock
RCLIPBOARD_FIFO_DIR=/run/user/1001/rclipboard
RCLIPCTL_TRANSPORT=auto

# Logging
RCLIPBOARD_LOG_LEVEL=info
RCLIPBOARD_PY_LOG_LEVEL=INFO
RCLIPBOARD_NOTIFY_DELAY_MS=250

# X clipboard
RCLIPBOARD_XSEL=1
RCLIPBOARD_XSEL_PATH=/usr/bin/xsel
RCLIPBOARD_XSEL_INTERVAL_MS=500

# Proxy (disabled by default)
RCLIPBOARD_PROXY=0
RCLIPBOARD_UPSTREAM_ENDPOINT=127.0.0.1:8988
